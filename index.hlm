<!doctype html>
<html lang="zh-Hant"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>協作中樞｜政府跨部門協調平台</title><meta name="description" content="整合跨部門主題討論、專案進度與共同問題的政府協作平台互動原型。"><style>:root{--navy:#142e3d;--teal:#087f77;--ink:#193442;--muted:#6b7d87;--line:#dfe7e9;--bg:#f3f6f7}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 'Segoe UI','Microsoft JhengHei',sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #32bfb0;outline-offset:3px}button{border:0}small{display:block}.sidebar{width:240px;background:var(--navy);color:#fff;position:fixed;inset:0 auto 0 0;padding:32px 20px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:12px;font-size:23px;font-weight:700;letter-spacing:2px}.logo{display:grid;place-items:center;width:42px;height:44px;border:1px solid #76aaa7;border-radius:10px;color:#9ce2d4}.brand small{font-size:9px;letter-spacing:1.3px;color:#a1b7c0;margin-top:3px}.workspace{margin:36px 0 28px;background:#223f4f;border:1px solid #365261;padding:12px;font-size:14px;border-radius:6px}.workspace span{float:right}.navlabel{font-size:12px;color:#8da7b4;padding:0 14px;margin-bottom:12px}nav{display:grid;gap:8px}nav button{text-align:left;display:flex;align-items:center;gap:14px;background:none;color:#afc1ca;border-radius:7px;padding:13px 15px}nav button.active{background:#285451;color:#d6fff1}nav button b{font-size:12px;margin-left:auto;background:#426568;padding:0 7px;border-radius:4px}.sidebottom{margin-top:auto}.demo{font-size:12px;color:#9bb7bf;border-bottom:1px solid #37505b;padding-bottom:18px}.person{display:flex;gap:10px;align-items:center;margin-top:20px;font-size:14px}.person small{font-size:12px;color:#9bb7bf}.avatar{display:inline-grid;place-items:center;width:37px;height:37px;border-radius:50%;background:#e4efed;color:#247569;font-size:14px;flex-shrink:0}.shell{margin-left:240px}header{height:78px;padding:0 42px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;background:#fff;font-size:14px;color:var(--muted)}header span{margin:0 12px}header b{font-weight:500;color:var(--ink)}.topdate{font-size:12px}.topdate i{display:inline-block;width:5px;height:5px;background:#85989c;border-radius:50%;margin:0 14px}main{max-width:1550px;margin:auto;padding:36px 42px}.heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px;gap:20px}.eyebrow{color:var(--teal);font-size:12px;letter-spacing:1.5px;font-weight:600}h1{font-size:30px;margin:8px 0;letter-spacing:1px}p{margin:0;color:var(--muted)}.primary{background:var(--teal);color:white;padding:12px 20px;border-radius:6px;font-size:14px;white-space:nowrap}.primary span{padding-left:16px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:26px}.metric{background:white;border:1px solid var(--line);padding:20px 24px;border-radius:8px}.metric .label{color:var(--muted);font-size:14px}.metric strong{display:block;font-size:34px;font-weight:600;line-height:1.4;margin:7px 0}.metric small{font-size:12px;color:var(--muted)}.metric strong span{font-size:14px;color:var(--muted);margin-left:8px}.metric.alert{border-top:3px solid #dba049;padding-top:18px}.grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(280px,1fr);gap:24px}.card{background:white;border:1px solid var(--line);border-radius:9px;margin-bottom:24px;overflow:hidden}.cardhead{padding:21px 24px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #edf0f2;gap:12px}h2{font-size:18px;margin:0;font-weight:600}h3{font-size:16px;margin:0 0 6px}.textbtn{background:none;color:var(--teal);font-size:14px;padding:3px}.tag{display:inline-block;border-radius:4px;background:#e6f4ee;color:#36816b;padding:3px 8px;font-size:12px;white-space:nowrap}.tag.warn{background:#fff1d9;color:#986816}.tag.neutral{background:#edf2f5;color:#5f7485}.project{padding:21px 24px;border-bottom:1px solid #edf0f2}.project:last-child{border:0}.projecttop{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.meta{font-size:12px;color:var(--muted)}.progressline{display:flex;align-items:center;gap:14px;margin:14px 0 8px}.bar{height:6px;background:#e9eff0;border-radius:10px;flex:1;overflow:hidden}.bar div{height:100%;background:#339e91;border-radius:10px}.progressline b{font-size:14px;font-weight:500}.projectfoot{display:flex;justify-content:space-between;gap:10px;font-size:12px;color:var(--muted)}.issue{padding:20px 24px;border-bottom:1px solid var(--line)}.issue p{font-size:14px;margin:8px 0 12px}.issue .meta{margin:10px 0}.issuehead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.signal{background:#fff8ed;border:1px solid #f2dfb7;border-radius:6px;padding:10px 12px;font-size:12px;color:#8c691f;margin-top:12px}.aicard{background:#eaf3f2;border-color:#c9dfdb}.aicard .cardhead{border-color:#c9dfdb}.aibody{padding:22px 24px}.aibody p{color:#496b6b;font-size:14px}.aibody .primary{width:100%;margin-top:20px}.ailabel{color:var(--teal);font-size:12px;margin-bottom:9px}.thread{display:flex;gap:13px;padding:18px 24px;border-bottom:1px solid #edf0f2;cursor:pointer}.thread:hover{background:#f5faf9}.thread p{font-size:14px}.thread .meta{margin-top:6px}.thread .hash{color:var(--teal);background:#eaf3f2;padding:3px 10px;height:34px;border-radius:5px}.thread strong{font-size:14px;font-weight:600}.thread .time{margin-left:auto;white-space:nowrap;font-size:12px;color:var(--muted)}footer{font-size:12px;color:#87989f;margin-top:32px;display:flex;gap:20px;justify-content:space-between}#toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#193c46;color:white;border-radius:7px;padding:12px 22px;display:none;z-index:10}.chatlayout{display:grid;grid-template-columns:240px 1fr;min-height:530px}.rooms{background:#fafcfc;border-right:1px solid var(--line);padding:14px}.rooms button{width:100%;text-align:left;background:none;border-radius:6px;padding:15px 12px;color:var(--ink);margin-bottom:6px;font-size:14px}.rooms button.selected{background:#dfefec;color:var(--teal)}.chatmain{display:flex;flex-direction:column;min-width:0}.messages{padding:24px;min-height:300px;max-height:450px;overflow:auto;flex:1}.message{display:flex;gap:12px;margin-bottom:25px}.bubble{background:#f1f5f6;padding:12px 16px;border-radius:0 8px 8px 8px;font-size:14px;margin-top:7px;white-space:pre-wrap;overflow-wrap:anywhere}.composer{border-top:1px solid var(--line);padding:18px;display:flex;gap:12px}.composer input{width:100%;min-width:0;border:1px solid #cedbdd;border-radius:6px;padding:12px;font-size:14px}.details{padding:24px}.details li{margin:10px 0;color:#526b76;font-size:14px}.aioptions{display:flex;gap:12px;align-items:center;margin-bottom:24px;flex-wrap:wrap}select{padding:11px;border:1px solid #c5d7d6;border-radius:6px;background:white;color:var(--ink);max-width:100%}.recommend{padding:23px;border:1px solid var(--line);border-radius:8px;margin-bottom:16px}.recommend p{font-size:14px}.source{background:#f3f7f7;padding:14px 18px;border-radius:6px;margin:14px 0;font-size:14px}.task{display:flex;align-items:center;gap:12px;padding:14px 0;border-top:1px solid var(--line);font-size:14px}.task input{width:18px;height:18px;accent-color:var(--teal)}.task span{flex:1}.task small{font-size:12px;color:var(--muted)}.notice{padding:12px 16px;background:#edf4f5;font-size:14px;border-radius:6px;color:#527078;margin-bottom:22px}@media(min-width:1550px){main{padding-top:45px}}@media(max-width:1150px){.sidebar{width:200px;padding:26px 14px}.shell{margin-left:200px}main{padding:28px 24px}header{padding:0 24px}.grid{grid-template-columns:1fr}.metrics{gap:12px}.metric{padding:16px}.brand{font-size:20px}.topdate{display:none}}@media(max-width:700px){.sidebar{position:static;width:100%;padding:18px}.brand small,.workspace,.navlabel,.sidebottom{display:none}.brand{font-size:20px}.logo{width:34px;height:34px}nav{display:flex;overflow:auto;margin-top:18px;gap:4px}nav button{font-size:14px;padding:9px;white-space:nowrap;gap:5px}nav button b{display:none}.shell{margin:0}header{height:52px;padding:0 20px}main{padding:24px 16px}.heading{align-items:flex-start;flex-direction:column}h1{font-size:26px}.metrics{grid-template-columns:1fr 1fr}.metric strong{font-size:28px}.cardhead,.project,.issue,.thread{padding:18px}.chatlayout{grid-template-columns:1fr}.rooms{display:flex;overflow:auto;border-right:0;border-bottom:1px solid var(--line)}.rooms button{white-space:nowrap;margin:0;width:auto}.composer{padding:12px;gap:8px}.primary{padding:11px 14px}footer{flex-direction:column;gap:8px}.projectfoot{flex-wrap:wrap}.thread .time{display:none}}
</style></head><body>
<aside class="sidebar"><div class="brand"><span class="logo">協</span><div>協作中樞<small>GOVERNMENT WORKSPACE</small></div></div><div class="workspace">跨部門協調辦公室 <span>⌄</span></div><div class="navlabel">工作空間</div><nav><button class="active" data-view="overview">▦ <span>協作總覽</span></button><button data-view="chat">◉ <span>主題聊天室</span><b>3</b></button><button data-view="projects">▤ <span>專案進度</span></button><button data-view="issues">◇ <span>共同問題</span><b id="issuecount">2</b></button><button data-view="ai">✧ <span>AI 協調助理</span></button></nav><div class="sidebottom"><div class="demo">互動原型・示範資料</div><div class="person"><span class="avatar">林</span><div>林協調員<small>專案協調辦公室</small></div></div></div></aside>
<div class="shell"><header><div>工作空間 <span>/</span> <b id="crumb">協作總覽</b></div><span class="topdate">2026 年 9 月 19 日 <i></i> 示範工作區</span></header><main><div class="heading"><div><div class="eyebrow">跨部門協作 / COORDINATION</div><h1 id="pagetitle">讓協調，向前一步。</h1><p id="subtitle">掌握專案脈動，及早處理部門之間的共同問題。</p></div><button class="primary" id="topaction">開啟主題討論 <span>↗</span></button></div><div id="content"></div><footer>協作中樞 <span>所有案件、人員、時程與建議均為示範；本原型不會傳送資料至政府機關。</span></footer></main></div><div id="toast" role="status"></div><script>const projects=[{name:'都市防汛整備計畫',lead:'水利局',deps:'工務局・民政局',due:'09/30',tasks:[['易淹水區域盤點','水利局',true],['排水設施巡檢','工務局',true],['避難動線確認','民政局',false],['跨局處演練','水利局',false]]},{name:'長照服務資源整合',lead:'社會局',deps:'衛生局・資訊處',due:'10/08',tasks:[['服務據點清冊','社會局',true],['轉介欄位對照','衛生局',false],['平台介接確認','資訊處',false]]},{name:'校園周邊通學安全',lead:'交通局',deps:'教育局・工務局',due:'10/15',tasks:[['重點路口調查','交通局',true],['學校需求彙整','教育局',true],['工程方案定案','工務局',true],['改善成果確認','交通局',false]]}];
const rooms=['防汛整備協調','長照資源整合','通學安全改善'];const chats=[[{who:'陳專員',dept:'水利局',text:'已完成易淹水區域盤點。排水設施巡檢結果已更新，請民政局協助確認避難動線。',time:'09:10'},{who:'王承辦',dept:'民政局',text:'避難動線需要對照最新道路施工範圍，請工務局提供路段清冊，避免規劃衝突。',time:'09:25'}],[{who:'李科員',dept:'社會局',text:'服務據點清冊已完成；兩局使用的轉介欄位不同，需先確認共同定義。',time:'08:45'},{who:'周專員',dept:'衛生局',text:'建議共同建立欄位對照表，並確認必要資料範圍。',time:'09:05'}],[{who:'張專員',dept:'教育局',text:'學校需求彙整已完成，請交通局確認改善工程的成果驗收時程。',time:'昨天'}]];
const issues=[{title:'道路施工與避難動線可能重疊',level:'高優先',projects:[0,2],body:'防汛整備與通學改善都涉及道路施工範圍，需共同確認施工期間的替代動線。',evidence:'防汛聊天室 09:25 的道路清冊需求；通學專案的工程方案任務。',action:'召開動線協調會議',owner:'工務局',handled:false},{title:'跨局處轉介資料欄位不一致',level:'待協調',projects:[1],body:'社會局與衛生局對轉介欄位的定義尚未一致，可能影響平台介接。',evidence:'長照聊天室 08:45 與 09:05 的欄位定義討論。',action:'建立共同欄位對照表',owner:'社會局',handled:false}];let view='overview',room=0,selectedIssue=0;const titles={overview:['讓協調，向前一步。','掌握專案脈動，及早處理部門之間的共同問題。'],chat:['主題聊天室','讓需求、回應與協調脈絡，留在同一個主題裡。'],projects:['專案進度','追蹤各部門交付事項，確認下一步的負責單位。'],issues:['共同問題','從跨部門討論與任務相依關係，找出需要一起處理的問題。'],ai:['AI 協調助理','對照討論脈絡，檢視可採取的協調方案與待確認事項。']};
const escape=s=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const pct=p=>Math.round(p.tasks.filter(t=>t[2]).length/p.tasks.length*100);const toast=s=>{const e=document.querySelector('#toast');e.textContent=s;e.style.display='block';setTimeout(()=>e.style.display='none',3200)};function go(v){view=v;render();window.scrollTo(0,0)}function projectCard(p,i,full=false){return `<div class="project"><div class="projecttop"><div><h3>${p.name}</h3><div class="meta">${p.lead} 主責 · ${p.deps}</div></div><span class="tag ${i===1?'warn':''}">${pct(p)===100?'已完成':i===1?'待協調':'進行中'}</span></div><div class="progressline"><div class="bar"><div style="width:${pct(p)}%"></div></div><b>${pct(p)}%</b></div><div class="projectfoot"><span>${p.tasks.filter(t=>t[2]).length} / ${p.tasks.length} 項任務完成</span><span>目標完成 ${p.due}</span></div>${full?p.tasks.map((t,j)=>`<label class="task"><input type="checkbox" data-task="${i},${j}" ${t[2]?'checked':''}><span>${t[0]}</span><small>${t[1]}</small></label>`).join(''):''}</div>`}
function issueCard(q,i){return `<div class="issue"><div class="issuehead"><span class="tag ${q.handled?'':'warn'}">${q.handled?'已建立協調任務':q.level}</span><span class="meta">${q.projects.length} 個關聯專案</span></div><h3>${q.title}</h3><p>${q.body}</p><div class="meta">${q.projects.map(j=>projects[j].name).join(' / ')}</div><button class="textbtn" data-ai="${i}">檢視依據與建議 →</button></div>`}
function overview(){const total=projects.reduce((a,p)=>a+p.tasks.length,0),done=projects.reduce((a,p)=>a+p.tasks.filter(t=>t[2]).length,0);return `<div class="metrics"><div class="metric"><div class="label">協作專案</div><strong>3<span>個</span></strong><small>8 個局處共同參與</small></div><div class="metric"><div class="label">任務完成率</div><strong>${Math.round(done/total*100)}<span>%</span></strong><small>已完成 ${done} / ${total} 項任務</small></div><div class="metric alert"><div class="label">待處理共同問題</div><strong>${issues.filter(q=>!q.handled).length}<span>項</span></strong><small>1 項涉及跨專案協調</small></div><div class="metric"><div class="label">主題討論</div><strong>3<span>個</span></strong><small>共 ${chats.flat().length} 則討論訊息</small></div></div><div class="grid"><div><section class="card"><div class="cardhead"><h2>專案進度</h2><button class="textbtn" data-go="projects">查看全部 ↗</button></div>${projects.map((p,i)=>projectCard(p,i)).join('')}</section><section class="card"><div class="cardhead"><h2>最新主題討論</h2><button class="textbtn" data-go="chat">進入聊天室 ↗</button></div>${rooms.map((r,i)=>{const m=chats[i].at(-1);return `<div class="thread" role="button" tabindex="0" data-room="${i}"><span class="hash">#</span><div><strong>${r}</strong><p>${escape(m.text)}</p><div class="meta">${m.who} · ${m.dept}</div></div><span class="time">${m.time}</span></div>`}).join('')}</section></div><div><section class="card"><div class="cardhead"><h2>共同問題提示</h2><span class="tag warn">需關注 ${issues.filter(q=>!q.handled).length}</span></div>${issues.map(issueCard).join('')}<div style="padding:0 24px 20px"><div class="signal">◇ 示範規則偵測 · 待協調員確認</div></div></section><section class="card aicard"><div class="cardhead"><h2>✧ AI 協調助理</h2><span class="ailabel">建議預覽</span></div><div class="aibody"><h3>讓共同問題有下一步</h3><p>彙整討論依據、提出協調步驟，並將採用的建議轉為待辦任務。</p><button class="primary" data-go="ai">檢視解決方案 →</button></div></section></div></div>`}
function chat(){return `<section class="card"><div class="chatlayout"><div class="rooms">${rooms.map((r,i)=>`<button data-room="${i}" class="${room===i?'selected':''}"># ${r}</button>`).join('')}</div><div class="chatmain"><div class="cardhead"><h2># ${rooms[room]}</h2><span class="tag neutral">${projects[room].lead} 等 3 個局處</span></div><div class="messages">${chats[room].map(m=>`<div class="message"><span class="avatar">${escape(m.who[0])}</span><div><div class="meta"><b>${m.who}</b> · ${m.dept} · ${m.time}</div><div class="bubble">${escape(m.text)}</div></div></div>`).join('')}</div><form class="composer" id="chatForm"><input aria-label="討論訊息" id="message" placeholder="提出需求或分享進度…" required maxlength="2000"><button class="primary" type="submit">送出</button></form></div></div></section><div class="notice">示範聊天室：訊息僅保留於本次頁面操作，尚未連接多人即時服務。</div>`}
function ai(){const q=issues[selectedIssue];return `<div class="notice">AI 功能展示：以下為預先編寫的示範建議，尚未串接 AI 模型或外部資料檢索。採用前請由承辦人核實。</div><div class="aioptions"><label for="topic">協調主題</label><select id="topic">${issues.map((q,i)=>`<option value="${i}" ${selectedIssue===i?'selected':''}>${q.title}</option>`).join('')}</select></div><div class="grid"><section class="card"><div class="cardhead"><h2>✧ 解決方案建議</h2><span class="tag neutral">示範分析</span></div><div class="details"><h3>${q.title}</h3><p>${q.body}</p><div class="source"><b>建議一｜${q.action}</b><p>${selectedIssue===0?'由工務局彙整施工清冊，水利局標註易淹水區，民政局確認避難路線，交通局提供通學改善範圍，共同檢查衝突。':'由社會局與衛生局共同整理欄位名稱、定義、格式及必要性，交由資訊處確認介接方式。'}</p></div><div class="source"><b>建議二｜先辦理小範圍驗證</b><p>${selectedIssue===0?'選擇一個重疊路段走查，確認替代動線與現場標示，再擴大到其他區域。':'以虛構測試資料驗證欄位對應，記錄無法轉換的項目，確認後再擴大驗證範圍。'}</p></div><h3>執行步驟</h3><ol><li>${q.owner} 彙整各單位需提供的資料。</li><li>安排跨局處確認會議，確定負責人與交付日期。</li><li>確認方案後更新專案任務，於下次會議追蹤。</li></ol><button class="primary" id="adopt" ${q.handled?'disabled':''}>${q.handled?'已加入專案待辦':'採用建議，建立協調任務'}</button></div></section><div><section class="card"><div class="cardhead"><h2>資料依據</h2></div><div class="details"><div class="ailabel">平台內示範資料</div><p>${q.evidence}</p><button class="textbtn" data-room="${q.projects[0]}" style="margin-top:16px">查看原始討論 →</button></div></section><section class="card"><div class="cardhead"><h2>仍需確認</h2></div><div class="details"><ul><li>${selectedIssue===0?'道路施工清冊是否為最新版本？':'哪些欄位是完成轉介所必需？'}</li><li>各單位是否同意主責與分工？</li><li>是否有尚未列入的限制或相依任務？</li></ul><p style="font-size:14px">本原型未引用外部政策文件，也未進行法規適用判斷。</p></div></section></div></div>`}
function render(){document.querySelector('#pagetitle').textContent=titles[view][0];document.querySelector('#subtitle').textContent=titles[view][1];document.querySelectorAll('nav button').forEach(b=>{b.classList.toggle('active',b.dataset.view===view);if(b.dataset.view===view)document.querySelector('#crumb').textContent=b.querySelector('span').textContent});document.querySelector('#issuecount').textContent=issues.filter(q=>!q.handled).length;document.querySelector('#content').innerHTML=view==='overview'?overview():view==='chat'?chat():view==='projects'?`<div class="notice">勾選已完成任務，進度會同步更新。此處的變更僅用於本次原型操作。</div>${projects.map((p,i)=>`<section class="card">${projectCard(p,i,true)}</section>`).join('')}`:view==='issues'?`<div class="notice">目前依示範討論與任務關聯呈現 2 項提示；正式版可在新增訊息或任務變更時自動偵測。</div><section class="card">${issues.map(issueCard).join('')}</section>`:ai();bind()}
function bind(){document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>go(b.dataset.go));document.querySelectorAll('[data-room]').forEach(b=>{b.onclick=()=>{room=+b.dataset.room;go('chat')};b.onkeydown=e=>{if(e.key==='Enter')b.click()}});document.querySelectorAll('[data-ai]').forEach(b=>b.onclick=()=>{selectedIssue=+b.dataset.ai;go('ai')});document.querySelectorAll('[data-task]').forEach(b=>b.onchange=()=>{const[i,j]=b.dataset.task.split(',').map(Number);projects[i].tasks[j][2]=b.checked;render()});const form=document.querySelector('#chatForm');if(form)form.onsubmit=e=>{e.preventDefault();const input=document.querySelector('#message'),s=input.value.trim();if(!s)return;chats[room].push({who:'林協調員',dept:'專案協調辦公室',text:s,time:'剛剛'});render();document.querySelector('.messages').scrollTop=100000;document.querySelector('#message').focus()};const topic=document.querySelector('#topic');if(topic)topic.onchange=()=>{selectedIssue=+topic.value;render()};const adopt=document.querySelector('#adopt');if(adopt)adopt.onclick=()=>{const q=issues[selectedIssue];if(q.handled)return;q.handled=true;projects[q.projects[0]].tasks.push([q.action,q.owner,false]);render();toast('已加入專案待辦，可到「專案進度」追蹤。')}}
document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>go(b.dataset.view));document.querySelector('#topaction').onclick=()=>go('chat');render();
</script></body></html>
